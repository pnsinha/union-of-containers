# Copy to site.env, edit, then:  source scripts/site.env
# Submit from the repository root with your allocation, e.g.
#   sbatch -A <cpu-account> scripts/e4s_provider_build.sbatch
#   sbatch -A <gpu-account> scripts/e4s_gpu_compose.sbatch
# Partition names in the #SBATCH headers (shared, gpu, gpu-debug, ai) are Anvil's;
# override with -p on other systems.

# Working root: holds trees/, stage/, logs/, the base image and the envs.
export UOC_ROOT=/path/to/scratch/union-of-containers

# Charliecloud 0.38 bin directory (only for ch_*.sbatch)
export CH_BIN=/path/to/charliecloud-0.38/bin
